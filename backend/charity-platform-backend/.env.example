# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ===== DATABASE =====
DB_URL=jdbc:mysql://localhost:3306/charity_platform?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# ===== JWT =====
# Generate with: openssl rand -base64 32
JWT_SECRET=your-base64-encoded-256-bit-secret

# ===== CORS (production only) =====
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ===== FILE UPLOADS =====
UPLOAD_DIR=/var/app/uploads/images
UPLOAD_URL_BASE=https://yourdomain.com/uploads/images
